---
import Base from '../layouts/Base.astro';

const stats = [
  { number: '10k+', caption: 'Members across all platforms' },
  { number: '2500+', caption: 'People gathered through events' },
  { number: '100+', caption: 'Cities represented in our community' },
  { number: '25+', caption: 'Countries represented in our community' },
];

const timeline = [
  { year: '2019', text: 'Founded in New York, NY' },
  { year: '2022', text: 'The first Talk Too Much: "Take-Out Only"' },
  { year: '2023', text: 'TTM: "Echoes From East Broadway"' },
  { year: '2024', text: 'TTM: "Navigating Fuzhounese Identity", and the first Lunar New Year Banquet' },
  { year: '2025', text: 'The first FZA Scholarship: ten students backed' },
  { year: '2026', text: 'Our first event in Fuzhou itself, after six years' },
];
---

<Base
  title="About | Fuzhou America"
  description="Why Fuzhou America exists: our mission, vision, and progress. 10k+ members across platforms, 100+ cities, 25+ countries."
  current="about"
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <h1>About Us</h1>
      <span class="page-head-cn" lang="zh">关于我们</span>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <h2 class="sec-title" set:html={'We are the primary organization dedicated to f&#111;stering Fuzhou American history, culture, and community.'} />
    </div>
  </section>

  <section class="section">
    <div class="shell story-grid">
      <div class="prose">
        <h2 class="sec-title">Our Mission: Why We Exist</h2>
        <p>
          You know how the story goes: someone in your family &mdash; likely your father/mother, uncle/aunt, or
          grandfather/grandmother &mdash; crossed the Atlantic by boat. Then, they opened a take-out restaurant in a
          corner of this country. From the rural villages back in Fuzhou, they succeeded in carving out a space in
          America.
        </p>
        <p>But with success came sacrifice.</p>
        <p set:html={'N&#111;t only did our parents give up their personal freedoms, but many of us also grew up in socially disconnected environments, stranded between assimilating into American life and helping out at the family restaurant.'} />
        <p>
          We lacked a community that fully understood our struggles with family relations, social dynamics, and
          personal identity. Fuzhou America (FZA) is that safe space.
        </p>
        <p>Here, at FZA, the next generation find peers who think like us, sound like us, and feel like us.</p>
      </div>
      <figure class="story-photo">
        <img src="/images/about/lny-hall.jpg" alt="The whole hall at the Fuzhou America Lunar New Year Banquet, over a hundred members with arms raised" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <h2 class="sec-title">Since 2019</h2>
      <div class="timeline">
        {timeline.map((t) => (
          <div class="timeline-item">
            <span class="timeline-year">{t.year}</span>
            <p>{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cc-last">
    <div class="shell">
      <h2 class="sec-title">What We've Accomplished</h2>
      <div class="stats-grid-page">
        {stats.map((s) => (
          <div>
            <div class="stat-number">{s.number}</div>
            <div class="stat-caption">{s.caption}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  .story-photo {
    margin: 0;
    background: #fff;
    padding: 10px;
    box-shadow: var(--shadow-warm);
    position: sticky;
    top: 24px;
  }
  .story-photo img {
    width: 100%;
    object-fit: cover;
  }
  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-photo {
      position: static;
      max-width: 480px;
    }
  }
</style>
