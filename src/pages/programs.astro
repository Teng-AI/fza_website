---
import Base from '../layouts/Base.astro';

// Event types, not a calendar: dates live on Instagram, so this page never goes stale.
// `ig` slots hold exemplar post links once confirmed.
const types = [
  {
    img: '/images/home/wall-mahjong.jpg',
    alt: 'Six members smiling around a mahjong table',
    name: 'Mahjong socials',
    desc: 'Tables on the sidewalk or in the park, all skill levels, somebody always teaching.',
  },
  {
    img: '/images/home/wall-open-mic.jpg',
    alt: 'Mid-song laughter at our Chinatown open mic',
    name: 'Open mics',
    desc: 'Open mic nights in Chinatown: songs, stories, first attempts.',
  },
  {
    name: 'Art events & film screenings',
    desc: 'Gallery nights, screenings, and panels, from DCTV to Pell Street.',
  },
  {
    img: '/images/community/community-9.jpg',
    alt: 'A long restaurant table under a fortune sign and red lantern',
    name: 'Curated dinners',
    desc: 'Small-group dinners at the places our families built.',
  },
  {
    name: 'Picnic socials',
    desc: 'Blankets and snacks in Central Park and Gantry Plaza, when the weather cooperates.',
  },
  {
    name: 'Happy hour socials',
    desc: 'Easy after-work meetups for new faces and old friends.',
  },
  {
    img: '/images/home/retreats.jpg',
    alt: 'Members playing basketball on a retreat',
    name: 'Retreats',
    desc: 'Smaller trips through the year, where people bond over shared experiences.',
  },
  {
    name: 'Fuzhou, China meetup',
    desc: 'When members are back home, we gather in Fuzhou itself.',
  },
];
---

<Base
  title="Programs | Fuzhou America"
  description="What Fuzhou America hosts: mahjong socials, open mics, art events and screenings, curated dinners, picnics, happy hours, retreats, and meetups from New York to Fuzhou."
  current="programs"
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <h1>Programs</h1>
      <span class="page-head-cn" lang="zh">活动</span>
      <p class="page-head-note">
        We meet on a regular basis. Dates and signups are announced on
        <a href="https://www.instagram.com/fuzhouamerica" class="head-link">@fuzhouamerica</a>; here is
        the kind of thing to expect.
      </p>
    </div>
  </header>

  <section class="section cc-last">
    <div class="shell">
      <h2 class="sec-title">What we host</h2>
      <div class="type-grid">
        {types.map((t) => (
          <article class="type-card">
            {t.img && <img src={t.img} alt={t.alt} loading="lazy" />}
            <div class="type-text">
              <h3>{t.name}</h3>
              <p>{t.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .head-link {
    color: #fff;
    font-weight: 700;
  }
  .type-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 18px;
    align-items: start;
  }
  .type-card {
    background: #fff;
    border: 1px solid var(--hair);
    border-top: 4px solid var(--red);
  }
  .type-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .type-text {
    padding: 16px 18px 20px;
  }
  .type-card h3 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 26px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin: 0;
  }
  .type-card p {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--ink-soft);
  }
</style>
