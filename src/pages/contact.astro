---
import Base from '../layouts/Base.astro';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xeebyoyo';
---

<Base
  title="Contact | Fuzhou America"
  description="Contact Fuzhou America for press, partnerships, or involvement. Based in Flushing, NY."
  current="contact"
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <h1>Contact Us</h1>
      <span class="page-head-cn" lang="zh">联系我们</span>
    </div>
  </header>

  <section class="section cc-last">
    <div class="shell contact-grid">
      <div>
        <h2 class="sec-title">Drop us a line</h2>
        <p>
          For any inquiries regarding press, partnerships, or involvement: use the form, or email
          <a href="mailto:info@fuzhouamerica.org">info@fuzhouamerica.org</a>.
        </p>
        <form action={FORMSPREE_ENDPOINT} method="POST">
          <label class="field">
            <span>Your name</span>
            <input class="form-field" type="text" name="name" autocomplete="name" />
          </label>
          <label class="field">
            <span>Your email</span>
            <input class="form-field" type="email" name="email" autocomplete="email" required />
          </label>
          <label class="field">
            <span>Message</span>
            <textarea class="form-field" name="message" maxlength="5000"></textarea>
          </label>
          <button type="submit" class="btn btn-red">Send message</button>
        </form>
      </div>
      <aside class="contact-aside">
        <h3>Contact</h3>
        <p><a href="mailto:info@fuzhouamerica.org">info@fuzhouamerica.org</a></p>
        <h3>Everywhere else</h3>
        <p><a href="https://www.instagram.com/fuzhouamerica">@fuzhouamerica</a></p>
        <p><a href="https://www.facebook.com/groups/subtlefuzhoutraits">Subtle Fuzhou Traits</a></p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 60px;
  }
  .contact-grid form {
    margin-top: 18px;
    max-width: 560px;
  }
  .contact-aside h3 {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-size: 20px;
    margin: 26px 0 4px;
    color: var(--red-deep);
  }
  .contact-aside h3:first-child {
    margin-top: 8px;
  }
  .contact-aside p {
    margin: 0 0 6px;
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
