---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | Fuzhou America">
  <header class="page-head">
    <div class="shell page-head-inner">
      <h1>Page Not Found</h1>
      <span class="page-head-cn" lang="zh">找不到页面</span>
    </div>
  </header>
  <section class="section cc-last">
    <div class="shell">
      <p>The page you are looking for does not exist or has moved.</p>
      <p><a href="/" class="btn btn-red">Back to Home</a></p>
    </div>
  </section>
</Base>
