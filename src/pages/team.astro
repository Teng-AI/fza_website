---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const team = await getCollection('team');
const byOrder = (a: any, b: any) => a.data.order - b.data.order;
const executive = team.filter((m) => m.data.board === 'executive').sort(byOrder);
const advisory = team.filter((m) => m.data.board === 'advisory').sort(byOrder);
---

<Base
  title="Team | Fuzhou America"
  description="Meet the Fuzhou America leadership and advisory board."
  current="team"
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <h1>Meet the Team</h1>
      <span class="page-head-cn" lang="zh">团队</span>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <h2 class="sec-title">Leadership</h2>
      <p class="sec-lede">We lay out the vision for the organization.</p>
      <div class="people-grid">
        {executive.map((m) => (
          <div class="person-card">
            <a href={m.data.linkedin}>
              <img src={m.data.image} alt={m.data.name} loading="lazy" />
              <h3>{m.data.name}</h3>
            </a>
            <p>{m.data.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cc-last">
    <div class="shell">
      <h2 class="sec-title">Advisory Board</h2>
      <p class="sec-lede">Our advisors carry expertise across industries.</p>
      <div class="people-grid">
        {advisory.map((m) => (
          <div class="person-card">
            <a href={m.data.linkedin}>
              <img src={m.data.image} alt={m.data.name} loading="lazy" />
              <h3>{m.data.name}</h3>
            </a>
            <p>{m.data.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
