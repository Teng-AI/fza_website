---
import Base from '../layouts/Base.astro';

// What donations fund. The page doesn't mention event ticketing (Teng, Nov 2026).
const funded = [
  {
    name: 'General programming',
    text: 'The mahjong tables, screenings, dinners, and picnics between the big events.',
    href: '/programs',
  },
  {
    name: 'The scholarship',
    text: 'Ten $2,500 awards to first-generation college students in 2025; paused for 2026.',
  },
  {
    name: 'Campus event funding',
    text: 'Through the Fuzhou Student Coalition, we fund students to host events on their own campuses and gather across schools.',
  },
  {
    name: 'Operations',
    text: 'Our team is 100% volunteers; donations cover the bills that keep a nonprofit running.',
  },
];
---

<Base
  title="Support Us | Fuzhou America"
  description="Support Fuzhou America with a tax-deductible donation. Donations fund general programming, student scholarships, campus event funding, and operations."
  current="support-us"
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <h1>Support Us</h1>
      <span class="page-head-cn" lang="zh">支持我们</span>
      <p class="page-head-note">Fuzhou America is a 501(c)(3) nonprofit with a 100% volunteer team.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell donate-grid">
      <div>
        <h2 class="sec-title">Make A Donation Today</h2>
        <p>
          Your tax-deductible donation funds our year-round programming, the students we back, and the
          operations behind it all.
        </p>
        <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_blank">
          <input type="hidden" name="cmd" value="_s-xclick" />
          <input type="hidden" name="hosted_button_id" value="XS9M7P7XLF95U" />
          <button type="submit" class="btn btn-red">Donate with PayPal</button>
        </form>
        <p class="donate-note">
          Questions about giving, sponsorship, or our <a href="/disclosures">donor disclosures</a>? Write to
          <a href="mailto:info@fuzhouamerica.org">info@fuzhouamerica.org</a>.
        </p>
      </div>
      <figure class="donate-photo">
        <img src="/images/support/volunteers.jpg" alt="Fuzhou America volunteers in matching crew shirts at the first Talk Too Much" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section cc-last">
    <div class="shell">
      <h2 class="sec-title">Where donations go</h2>
      <div class="funded-grid">
        {funded.map((f) => (
          f.href ? (
            <a class="tile" href={f.href}>
              <span class="tile-name">{f.name}</span>
              <span class="tile-desc">{f.text}</span>
            </a>
          ) : (
            <div class="tile">
              <span class="tile-name">{f.name}</span>
              <span class="tile-desc">{f.text}</span>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .donate-grid {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .donate-grid form {
    margin-top: 10px;
  }
  .donate-note {
    margin-top: 22px;
    font-size: 14.5px;
    color: var(--ink-soft);
  }
  .donate-note a {
    color: var(--red-deep);
  }
  .donate-photo {
    margin: 0;
    background: #fff;
    padding: 10px;
    box-shadow: var(--shadow-warm);
  }
  .donate-photo img {
    width: 100%;
    object-fit: cover;
  }
  .funded-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  @media (max-width: 860px) {
    .donate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
