---
import Base from '../layouts/Base.astro';

const funded = [
  { name: 'Talk Too Much', text: 'The themed annual conference, free or near-free to attend since 2022.', href: '/conference' },
  { name: 'First Light Film Festival', text: 'A stage for emerging AAPI filmmakers in Brooklyn.', href: '/programs' },
  { name: 'Lunar New Year Banquet', text: 'The community table, every Spring Festival.', href: 'https://www.instagram.com/fuzhouamerica' },
];
---

<Base
  title="Support Us | Fuzhou America"
  description="Support Fuzhou America with a tax-deductible donation. We are a 501(c)(3) nonprofit with a 100% volunteer-based team."
  current="support-us"
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <h1>Support Us</h1>
      <span class="page-head-cn" lang="zh">支持我们</span>
      <p class="page-head-note">Fuzhou America is a 501c3 non-profit with a 100% volunteer-based team.</p>
    </div>
  </header>

  <section class="section">
    <div class="shell donate-grid">
      <div>
        <h2 class="sec-title">Make A Donation Today</h2>
        <p>Make your tax-deductible contribution to Fuzhou America now!</p>
        <form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_blank">
          <input type="hidden" name="cmd" value="_s-xclick" />
          <input type="hidden" name="hosted_button_id" value="XS9M7P7XLF95U" />
          <button type="submit" class="btn btn-red">Donate with PayPal</button>
        </form>
        <p class="donate-note">
          Questions about giving, sponsorship, or our <a href="/disclosures">donor disclosures</a>? Write to
          <a href="mailto:info@fuzhouamerica.org">info@fuzhouamerica.org</a>.
        </p>
      </div>
      <figure class="donate-photo">
        <img src="/images/support/donate.jpg" alt="Fuzhou America volunteers and a full audience at the annual conference" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section cc-last">
    <div class="shell">
      <h2 class="sec-title">What support makes possible</h2>
      <div class="funded-grid">
        {funded.map((f) => (
          <a class="tile" href={f.href}>
            <span class="tile-name">{f.name}</span>
            <span class="tile-desc">{f.text}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .donate-grid {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .donate-grid form {
    margin-top: 10px;
  }
  .donate-note {
    margin-top: 22px;
    font-size: 14.5px;
    color: var(--ink-soft);
  }
  .donate-note a {
    color: var(--red-deep);
  }
  .donate-photo {
    margin: 0;
    background: #fff;
    padding: 10px;
    box-shadow: var(--shadow-warm);
  }
  .donate-photo img {
    width: 100%;
    object-fit: cover;
  }
  .funded-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  @media (max-width: 860px) {
    .donate-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
