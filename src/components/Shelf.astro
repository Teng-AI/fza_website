---
// The community shelf: works the community makes and FZA champions, with maker credits.
// Shown on the homepage and /culture; edit in one place. Order set by Teng (Nov 2026).
const works = [
  {
    href: 'https://www.instagram.com/flavorsoffujian',
    name: 'Flavors of Fujian',
    desc: 'Fujianese food stories, dish by dish.',
    credit: 'By Allen Cao & Jess Eng',
  },
  {
    href: 'https://threegolds.app/',
    name: 'Three Golds Mahjong',
    desc: 'A mahjong app that plays Fuzhou style.',
    credit: 'By Teng Zheng',
  },
  {
    href: 'https://seedandspark.com/fund/funeral-procession-of-fireflies',
    name: 'A Funeral Procession of Fireflies',
    desc: 'A feature film in development, set in 1990s Fuzhou.',
    credit: 'By Cynthia Lin & Weijia Zhou',
  },
  {
    href: 'https://fuzhounese.org/',
    name: 'Fuzhounese-English Dictionary',
    desc: 'Look up the words your family actually says.',
    credit: 'By Noah Lee',
  },
  {
    href: 'https://www.fuzhoufood.com/',
    name: 'Fuzhou Food',
    desc: "Home recipes from Fuzhou, one of China's eight great cuisines.",
    credit: 'By brothers Ray & Rich',
  },
];
---

<div class="shelf">
  {works.map((w) => (
    <a class="tile" href={w.href}>
      <span class="tile-name">{w.name}</span>
      <span class="tile-desc">{w.desc}</span>
      <span class="tile-credit">{w.credit}</span>
    </a>
  ))}
</div>
